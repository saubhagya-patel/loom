# Copy to backend/.env:  cp backend/.env.example backend/.env
#
# Loaded by `node --env-file-if-exists=.env`. A real environment variable always
# wins over a value here, and a missing file is not an error.

# Prisma needs this, so it is the single database setting (docs/plan.md §2.1).
DATABASE_URL="mysql://luma:luma@127.0.0.1:3306/luma"

LUMA_HOST=127.0.0.1
LUMA_PORT=8080

# level: debug | info | warn | error      format: text | json
LUMA_LOG_LEVEL=info
LUMA_LOG_FORMAT=text

LUMA_SHUTDOWN_TIMEOUT_MS=10000

# Phase 1 adds, each with its own config test:
#   LUMA_TOKEN_KEY            32 random bytes, base64 — encrypts refresh tokens at rest
#   LUMA_GOOGLE_CLIENT_ID
#   LUMA_GOOGLE_CLIENT_SECRET
#   LUMA_SESSION_SECRET
