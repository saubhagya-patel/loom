# Copy to backend/.env:  cp backend/.env.example backend/.env
#
# Loaded by `node --env-file-if-exists=.env`. A real environment variable always
# wins over a value here, and a missing file is not an error.

# Prisma needs this, so it is the single database setting (docs/plan.md §2.1).
DATABASE_URL="mysql://loom:loom@127.0.0.1:3307/loom"

LOOM_HOST=127.0.0.1
LOOM_PORT=8080

# level: debug | info | warn | error      format: text | json
LOOM_LOG_LEVEL=info
LOOM_LOG_FORMAT=text

LOOM_SHUTDOWN_TIMEOUT_MS=10000

# --- Phase 1 -----------------------------------------------------------------
# All four are required: the server refuses to start without them, by design.
# None of these values belong in git.

# From the Google Cloud console OAuth client (Web application).
LOOM_GOOGLE_CLIENT_ID=
LOOM_GOOGLE_CLIENT_SECRET=

# Encrypts refresh tokens at rest (docs/plan.md §2.2). Must decode to exactly 32
# bytes, checked at startup.        generate:  openssl rand -base64 32
LOOM_TOKEN_KEY=

# Signs the session cookie. Any string of 16+ characters.
LOOM_SESSION_SECRET=

# The browser origin allowed to POST, and the redirect_uri tried first. 127.0.0.1
# rather than localhost because vite pins that host and Google treats them as
# different origins (agent-cache/knowledge.md).
LOOM_WEB_ORIGIN=http://127.0.0.1:5173

# true only behind HTTPS. Leave false for local development.
LOOM_COOKIE_SECURE=false

# --- single-service deployment (Render) --------------------------------------
# Set this and the API process also serves the built SPA, keeping the frontend
# same-origin with the API. Leave it unset in development, where vite serves the
# app and proxies /api here.
#   LOOM_STATIC_DIR=/opt/render/project/src/web/dist
#
# The host assigns the port through PORT; LOOM_PORT still wins where it is set.
