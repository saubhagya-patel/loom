{
  "name": "loom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "npm run -w @loom/backend dev",
    "start": "npm run -w @loom/backend start",
    "dev:web": "npm run -w web dev",
    "typecheck": "npm run -w @loom/backend typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run -w @loom/backend test",
    "test:e2e": "backend/tests/e2e/run.sh",
    "preverify": "node scripts/require-node.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run web:lint && npm run web:build",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose stop mysql",
    "db:reset": "docker compose down -v",
    "db:shell": "docker compose exec mysql mysql -uloom -ploom loom",
    "db:logs": "docker compose logs -f mysql",
    "prisma:generate": "npm run -w @loom/backend prisma:generate",
    "prisma:pull": "npm run -w @loom/backend prisma:pull",
    "prisma:studio": "npm run -w @loom/backend prisma:studio",
    "web:build": "npm run -w web build",
    "web:lint": "npm run -w web lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
